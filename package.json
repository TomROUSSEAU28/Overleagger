{
  "name": "overleagger",
  "private": true,
  "description": "Hierarchical whiteboard editor for electronics, power electronics and control-system diagrams.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @overleagger/web dev",
    "build": "pnpm --filter @overleagger/web build",
    "preview": "pnpm --filter @overleagger/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @overleagger/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
